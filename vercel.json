{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "PLINTH_BASE=/ VITE_PLINTH_API= npm run web:build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/fonts/*.woff"
    }
  },
  "rewrites": [
    { "source": "/f/:id", "destination": "/api?route=f&id=:id" },
    { "source": "/api/:route", "destination": "/api?route=:route" }
  ]
}
